# Copy to backend/.env for local development.
# Do not commit real credentials.

APP_ENV=development
API_PORT=8000
DATABASE_URL=sqlite:///./relay4.db

# This secret authenticates ElevenLabs server-side webhook tool requests.
ELEVENLABS_AGENT_ID=YOUR_AGENT_ID_HERE
ELEVENLABS_WEBHOOK_SECRET=generate-a-long-random-secret
ELEVENLABS_WEBHOOK_HEADER=X-ElevenLabs-Webhook-Secret

# Required for protected manual incident writes.
ADMIN_API_KEY=generate-a-different-long-random-secret

# Operator login. Leave OPERATOR_PASSWORD blank to use ADMIN_API_KEY locally.
OPERATOR_USERNAME=Pete
OPERATOR_PASSWORD=

# Keep true for the synthetic hackathon workflow.
SIMULATION_MODE=true

# Optional comma-separated browser origins, for example:
# Allow the Vite development server to call this API from the browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
